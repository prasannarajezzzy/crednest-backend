# Copy this file to .env and fill only values that are ready for production.
#
# Lead delivery is resolved in this order:
#   1. VITE_LEAD_ENDPOINT  — custom webhook, works on any host
#   2. VITE_LEAD_MODE      — "php" (Hostinger/Apache), "vercel", or "netlify"
#   3. neither             — demo mode: nothing is sent, payload logged locally
#
# CredNest deploys to Hostinger, so VITE_LEAD_MODE=php is already set in
# .env.production and applies automatically to `npm run build`. Leave the
# value below blank so `npm run dev` stays in demo mode.
VITE_LEAD_MODE=

# Optional custom webhook (Make.com, Zapier, your own API). Receives JSON.
# Takes precedence over VITE_LEAD_MODE when both are set.
VITE_LEAD_ENDPOINT=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# With this blank, no analytics loads and no consent banner appears,
# because the site then sets no non-essential cookies at all.
VITE_GA_ID=
